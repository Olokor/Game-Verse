{
  "$description": "GameVerse design tokens. Single source for docs/design/DESIGN_SYSTEM.md sections 2 to 5. Edit here, then run `make tokens`. Keys are kebab-case; each leaf has $type and $value.",
  "color": {
    "bg": {
      "base": { "$type": "color", "$value": "#0A0B10", "$description": "App background" },
      "surface": { "$type": "color", "$value": "#12141C", "$description": "Cards, sheets" },
      "elevated": { "$type": "color", "$value": "#1A1D28", "$description": "Modals, popovers, pressed cards" },
      "inset": { "$type": "color", "$value": "#07080C", "$description": "Inputs, wells, board backgrounds" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#232736", "$description": "Dividers, card borders" },
      "strong": { "$type": "color", "$value": "#343A4F", "$description": "Focus-adjacent, active outlines" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#F2F3F7", "$description": "Headings, body" },
      "secondary": { "$type": "color", "$value": "#9AA0B4", "$description": "Supporting text" },
      "muted": { "$type": "color", "$value": "#5E6478", "$description": "Hints, disabled" }
    },
    "brand": {
      "volt": { "$type": "color", "$value": "#C8FF3D", "$description": "THE brand color. Primary buttons, active tab, XP. Use sparingly." },
      "volt-ink": { "$type": "color", "$value": "#0A0B10", "$description": "Text on volt" }
    },
    "accent": {
      "flare": { "$type": "color", "$value": "#FF5A36", "$description": "Live, hot, urgency, tournaments" },
      "sky": { "$type": "color", "$value": "#4DA3FF", "$description": "Info, friends online, links" }
    },
    "state": {
      "success": { "$type": "color", "$value": "#3DDC97", "$description": "Wins, confirmations" },
      "danger": { "$type": "color", "$value": "#FF4D6A", "$description": "Losses, destructive" },
      "warning": { "$type": "color", "$value": "#FFC23D", "$description": "Coins, warnings" }
    },
    "currency": {
      "coin": { "$type": "color", "$value": "#FFC23D", "$description": "Coin icon and values" },
      "gem": { "$type": "color", "$value": "#B07CFF", "$description": "Premium currency (later)" }
    },
    "category": {
      "board": { "$type": "color", "$value": "#3DDC97", "$description": "Category chips, card glows and game headers only" },
      "cards": { "$type": "color", "$value": "#FF5A36", "$description": "Category chips, card glows and game headers only" },
      "arcade": { "$type": "color", "$value": "#C8FF3D", "$description": "Category chips, card glows and game headers only" },
      "racing": { "$type": "color", "$value": "#4DA3FF", "$description": "Category chips, card glows and game headers only" },
      "fight": { "$type": "color", "$value": "#FF4D6A", "$description": "Category chips, card glows and game headers only" },
      "adventure": { "$type": "color", "$value": "#B07CFF", "$description": "Category chips, card glows and game headers only" },
      "brain": { "$type": "color", "$value": "#FFC23D", "$description": "Category chips, card glows and game headers only" }
    },
    "rank": {
      "bronze": { "$type": "color", "$value": "#C98A5A", "$description": "Rank badge" },
      "silver": { "$type": "color", "$value": "#B9C2D0", "$description": "Rank badge" },
      "gold": { "$type": "color", "$value": "#FFC23D", "$description": "Rank badge" },
      "platinum": { "$type": "color", "$value": "#7FE3E0", "$description": "Rank badge" },
      "diamond": { "$type": "color", "$value": "#7FA8FF", "$description": "Rank badge" },
      "legend": { "$type": "color", "$value": "#C8FF3D", "$description": "Rank badge" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Clash Display", "Space Grotesk"], "$description": "Game titles, big numbers, rank-ups. Fallback Space Grotesk." },
      "body": { "$type": "fontFamily", "$value": ["Satoshi", "Inter"], "$description": "Everything else. Fallback Inter." }
    },
    "weight": {
      "display-semibold": { "$type": "fontWeight", "$value": 600, "$description": "Display text" },
      "display-bold": { "$type": "fontWeight", "$value": 700, "$description": "Display text, emphasis" }
    },
    "numeric": { "$type": "string", "$value": "tabular-nums", "$description": "Scores, timers, currency: tabular figures so digits don't jitter" },
    "size": {
      "label": { "$type": "dimension", "$value": "11px", "$description": "Tiny uppercase labels (11 to 12px)" },
      "caption": { "$type": "dimension", "$value": "12px", "$description": "Caption" },
      "body-sm": { "$type": "dimension", "$value": "14px", "$description": "Small body" },
      "body": { "$type": "dimension", "$value": "16px", "$description": "Body" },
      "title-sm": { "$type": "dimension", "$value": "18px", "$description": "Small title" },
      "title": { "$type": "dimension", "$value": "22px", "$description": "Title" },
      "headline": { "$type": "dimension", "$value": "28px", "$description": "Headline" },
      "display": { "$type": "dimension", "$value": "36px", "$description": "Display" },
      "hero-number": { "$type": "dimension", "$value": "56px", "$description": "Hero numbers" }
    },
    "line-height": {
      "body": { "$type": "number", "$value": 1.4, "$description": "Body text" },
      "display": { "$type": "number", "$value": 1.1, "$description": "Display sizes" }
    },
    "letter-spacing": {
      "display": { "$type": "dimension", "$value": "-0.02em", "$description": "Display sizes" },
      "label": { "$type": "dimension", "$value": "0.08em", "$description": "Tiny uppercase labels" }
    }
  },
  "space": {
    "4": { "$type": "dimension", "$value": "4px" },
    "8": { "$type": "dimension", "$value": "8px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "20": { "$type": "dimension", "$value": "20px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "40": { "$type": "dimension", "$value": "40px" },
    "56": { "$type": "dimension", "$value": "56px" },
    "72": { "$type": "dimension", "$value": "72px" }
  },
  "layout": {
    "gutter": {
      "mobile": { "$type": "dimension", "$value": "16px", "$description": "Screen gutter, mobile" },
      "tablet": { "$type": "dimension", "$value": "24px", "$description": "Screen gutter, tablet" },
      "desktop": { "$type": "dimension", "$value": "32px", "$description": "Screen gutter, desktop (minimum)" }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "14px", "$description": "Buttons" },
    "lg": { "$type": "dimension", "$value": "20px", "$description": "Game cards" },
    "xl": { "$type": "dimension", "$value": "28px" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Pill buttons, chips" }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "1px", "$description": "Elevation is surface steps plus a 1px border, not shadows" }
  },
  "motion": {
    "instant": {
      "duration": { "$type": "duration", "$value": "90ms", "$description": "Press feedback" },
      "easing": { "$type": "cubicBezier", "$value": "ease-out" }
    },
    "fast": {
      "duration": { "$type": "duration", "$value": "160ms", "$description": "Toggles, chips, small reveals" },
      "easing": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
    },
    "base": {
      "duration": { "$type": "duration", "$value": "240ms", "$description": "Screen transitions, sheets" },
      "easing": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
    },
    "slow": {
      "duration": { "$type": "duration", "$value": "380ms", "$description": "Hero card expansion, results" },
      "spring-stiffness": { "$type": "number", "$value": 300, "$description": "Spring easing for motion.slow" },
      "spring-damping": { "$type": "number", "$value": 26, "$description": "Spring easing for motion.slow" }
    },
    "celebrate": {
      "duration-min": { "$type": "duration", "$value": "900ms", "$description": "Win, level up, rank up, chest. Choreographed in Rive." },
      "duration-max": { "$type": "duration", "$value": "1600ms", "$description": "Win, level up, rank up, chest. Choreographed in Rive." }
    },
    "press-scale": { "$type": "number", "$value": 0.96, "$description": "Every pressable scales to this on press" }
  }
}
