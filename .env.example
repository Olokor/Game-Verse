# Copy to .env for local development (`cp .env.example .env`). .env is never committed.
# Settings for the .NET services use GameVerse__Section__Key; docker-compose.yml builds those from the values below.

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development

# --- Host ports (bound to 127.0.0.1 only) ---
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL 16 ---
POSTGRES_DB=gameverse
POSTGRES_USER=gameverse
# Local dev only. Production uses a secret store. Must match appsettings.Development.json for `dotnet run`.
POSTGRES_PASSWORD=gameverse_dev

# --- Auth (ADR-0006) ---
# ECDSA P-256 private key (PEM) that signs access tokens; newlines may be written as 
. Optional in Development (an
# ephemeral key is generated, so tokens stop working when the API restarts); required everywhere else.
# Generate: openssl ecparam -name prime256v1 -genkey -noout
GAMEVERSE_AUTH_SIGNING_KEY=

# --- Email (ADR-0006) ---
# Default: Mailpit catches every email (UI http://127.0.0.1:8025); leave these empty to keep it that way.
# To send real mail from your own Gmail (development only; Gmail limits daily sends):
#   create an app password (Google Account > Security > 2-Step Verification > App passwords), then set
#   GAMEVERSE_EMAIL_HOST=smtp.gmail.com  GAMEVERSE_EMAIL_PORT=587  GAMEVERSE_EMAIL_SECURITY=StartTls
#   GAMEVERSE_EMAIL_USERNAME=you@gmail.com  GAMEVERSE_EMAIL_PASSWORD=<app password>  GAMEVERSE_EMAIL_FROM=GameVerse <you@gmail.com>
# Production uses a transactional email provider, chosen before deploy.
GAMEVERSE_EMAIL_HOST=
GAMEVERSE_EMAIL_PORT=
GAMEVERSE_EMAIL_SECURITY=
GAMEVERSE_EMAIL_USERNAME=
GAMEVERSE_EMAIL_PASSWORD=
GAMEVERSE_EMAIL_FROM=
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Logging ---
# true = human-readable console, false = JSON (production default)
GAMEVERSE_LOG_PRETTY=false

# --- Error reporting (ADR-0005): Sentry SDKs -> self-hosted GlitchTip. `make errors-up`, then `make errors-setup`. ---
GLITCHTIP_PORT=8000
# Local dev only. Production uses a secret store.
GLITCHTIP_SECRET_KEY=dev-only-change-me-0123456789abcdef
GLITCHTIP_DB_PASSWORD=glitchtip_dev
GLITCHTIP_ADMIN_EMAIL=admin@gameverse.local
GLITCHTIP_ADMIN_PASSWORD=glitchtip_dev_admin
# DSNs printed by `make errors-setup`. Empty = reporting off (the default).
# API DSN uses host glitchtip:8000 (compose network); web and Unity use 127.0.0.1:8000.
GAMEVERSE_ERROR_DSN_API=
GAMEVERSE_ERROR_ENVIRONMENT=development
VITE_ERROR_DSN=
UNITY_ERROR_DSN=
# Read-only use by verification scripts (`make errors-setup` prints it).
GLITCHTIP_API_TOKEN=
