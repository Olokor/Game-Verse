# Copy to .env for local development (`cp .env.example .env`). .env is never committed.
# Settings for the .NET services use GameVerse__Section__Key; docker-compose.yml builds those from the values below.

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development

# --- Host ports (bound to 127.0.0.1 only) ---
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL 16 ---
POSTGRES_DB=gameverse
POSTGRES_USER=gameverse
# Local dev only. Production uses a secret store. Must match appsettings.Development.json for `dotnet run`.
POSTGRES_PASSWORD=gameverse_dev

# --- Logging ---
# true = human-readable console, false = JSON (production default)
GAMEVERSE_LOG_PRETTY=false
