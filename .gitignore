# GameVerse root ignore rules.
# Unity-specific rules live in apps/mobile/.gitignore (see ADR-0002).

# --- Secrets and environment ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
staticfiles/
media/

# --- Node / web ---
node_modules/
dist/
.vite/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
.pnpm-store/

# --- Logs and OS / editor files ---
*.log
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# --- Claude Code personal settings ---
.claude/settings.local.json
