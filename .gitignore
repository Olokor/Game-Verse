# GameVerse root ignore rules.
# Unity-specific rules live in apps/mobile/.gitignore (see CLAUDE.md section 3, Infrastructure).

# --- Secrets and environment ---
.env
.env.*
!.env.example
*.pem
*.key

# --- .NET ---
bin/
obj/
.vs/
TestResults/
*.user
*.suo
*.coverage
coverage.cobertura.xml

# --- Unity: shared library build output (recreated by `make rules`) ---
apps/mobile/Assets/GameVerse/Plugins/Shared/*.dll
apps/mobile/Assets/GameVerse/Plugins/Shared/*.pdb
apps/mobile/Assets/GameVerse/Plugins/Shared/GameVerse.*.xml

# --- Node / web ---
node_modules/
dist/
.vite/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
.pnpm-store/

# --- Logs and OS / editor files ---
*.log
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# --- Claude Code personal settings ---
.claude/settings.local.json
