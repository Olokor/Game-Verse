<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- `make schema` writes the OpenAPI document here at build time (Microsoft.Extensions.ApiDescription.Server). -->
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(RepoRoot)packages/api-schema</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GameVerse.Platform/GameVerse.Platform.csproj" />
    <ProjectReference Include="../GameVerse.Infrastructure/GameVerse.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GameVerse.Api.IntegrationTests" />
  </ItemGroup>
</Project>
