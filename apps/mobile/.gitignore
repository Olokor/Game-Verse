# IDE files Unity regenerates
*.csproj
*.sln
*.slnx
*.suo
*.user
*.pidb
*.booproj
.vs/
.idea/
.vscode/

# Build output from `make rules` (shared DLLs are ignored in the root .gitignore; fixtures here)
/Assets/GameVerse/Resources/Fixtures/
/Assets/GameVerse/Resources/Fixtures.meta

# Crash and build reports
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.symbols.zip

# Android native build intermediates (CMake/ninja) written by the Gradle build
/.utmp/

# Burst output for Web builds
/Data/

# Prompt 0.7 spike: scenes, lightmaps and materials are regenerated by SpikeSetup on every `make web-spike`
/Assets/GameVerse/Spike/Generated/
/Assets/GameVerse/Spike/Generated.meta
/Assets/GameVerse/Spike/Spike3D/
/Assets/GameVerse/Spike/Spike3D.meta
/Assets/GameVerse/Spike/Spike2D.unity*
/Assets/GameVerse/Spike/Spike3D.unity*
